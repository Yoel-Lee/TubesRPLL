generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================== ENUM ==========================

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceType {
  IN
  OUT
}

// ========================== MODELS ==========================

model User {
  id             Int             @id @default(autoincrement())
  name           String
  email          String          @unique
  password       String
  role           Role            @default(STAFF)
  status         UserStatus      @default(ACTIVE)
  createdAt      DateTime        @default(now())
  baseSalary     Float           @default(0)
  phoneNumber    String?
  address        String?

  // Relasi Hierarki Manajer
  managerId      Int?
  manager        User?           @relation("UserManager", fields: [managerId], references: [id])
  staffs         User[]          @relation("UserManager")

  // Relasi Data
  leaves          Leave[]
  reimbursements  Reimbursement[]
  attendances     Attendance[]
  dendas          Denda[]
  bonuses         Bonus[]
  notifications   Notification[]
  activityLogs    ActivityLog[]
}

model Leave {
  id        Int           @id @default(autoincrement())
  startDate DateTime
  endDate   DateTime
  reason    String
  status    RequestStatus @default(PENDING)
  userId    Int
  user      User          @relation(fields: [userId], references: [id])
  isPaid Boolean @default(true)
}

model Reimbursement {
  id          Int           @id @default(autoincrement())
  date        DateTime
  description String
  amount      Float
  status      RequestStatus @default(PENDING)
  userId      Int
  user        User          @relation(fields: [userId], references: [id])
}

model Attendance {
  id     Int            @id @default(autoincrement())
  time   DateTime       @default(now())
  type   AttendanceType
  userId Int
  user   User           @relation(fields: [userId], references: [id])
}

// ========================== MODEL DENDA ==========================

model Denda {
  id        Int      @id @default(autoincrement())
  amount    Float    // jumlah denda
  notes     String?  // catatan (opsional)
  createdAt DateTime @default(now())

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model Bonus {
  id        Int      @id @default(autoincrement())
  amount    Float
  notes     String?
  createdAt DateTime @default(now())

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

// ========================== MODEL NOTIFIKASI ==========================

model Notification {
  id        Int      @id @default(autoincrement())
  title     String   // Judul notif (misal: "Cuti Disetujui")
  message   String   // Isi pesan detail
  isRead    Boolean  @default(false) // Status dibaca/belum
  createdAt DateTime @default(now())

  userId    Int      // Penerima notifikasi
  user      User     @relation(fields: [userId], references: [id])
}

// ========================== MODEL ACTIVITY LOG ==========================

model ActivityLog {
  id        Int      @id @default(autoincrement())
  action    String   // Kategori aksi (Contoh: "APPROVE_LEAVE", "UPDATE_STAFF")
  details   String   // Deskripsi lengkap (Contoh: "Budi menyetujui cuti Adelia")
  createdAt DateTime @default(now())

  userId    Int      // Siapa pelakunya (Admin/Staff)
  user      User     @relation(fields: [userId], references: [id])
}